{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=AIHelpDeskDb;TrustServerCertificate=True;Trusted_Connection=True;"
  },
  "JwtSettings": {
    "Issuer": "AIHelpDesk.API",
    "Audience": "AIHelpDesk.API",
    "AccessTokenExpirationMinutes": 5,
    "RefreshTokenExpirationMinutes": 10
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbeddingModel": "nomic-embed-text",
    "ChatModel": "llama3.2"
  }
}